# Copy to local.env (gitignored) and adjust. Sourced by scripts/setup-check.sh;
# for python scripts: `set -a; . ./local.env; set +a` first.
EMUCAP_MCP=/path/to/emucap/target/release/emucap-mcp
MESEN_BIN=/path/to/emucap/adapters/mesen2/work/mesen/bin/.../publish/Mesen.app/Contents/MacOS/Mesen   # emucap adapters/mesen2/build.sh (needs emucap d141eda+)
EMUCAP_GBA_BIOS=/path/to/gba_bios.bin
# MGBA=/Applications/mGBA.app/Contents/MacOS/mGBA
# NOTARY_PROFILE=...   # macOS release signing: xcrun notarytool store-credentials NAME; scripts/package.py --sign
